---
import Layout from "../layouts/Layout.astro";
import CustomSection from "../components/CustomSection.astro";
import InlineLink from "../components/InlineLink.astro";
import { SITE_NAME } from "../consts";

const slug = (item: string) =>
  item
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const interests = [
  "Nix/NixOS & Linux",
  "Kubernetes",
  "Azure DevOps",
  "Rust, Go, Zig, Java & C",
  "Microcontrollers (ESP & Arduino)",
  "Shell scripting (Bash, Fish, PowerShell)",
];

const stuffIWorkedOn = [
  {
    name: "garret",
    link: "https://github.com/jeiang/garret",
    content:
      "A single-tenant Nix binary cache: an OIDC-protected pusher and a public puller, colocated on one host over SQLite + S3. The successor to attic for my infrastructure.",
  },
  {
    name: "rip",
    link: "https://github.com/jeiang/ripper",
    content:
      "A rip-style trash CLI for Linux that handles bind mounts and btrfs subvolumes correctly, for NixOS impermanence setups.",
  },
  {
    name: "erdtree (fork)",
    link: "https://github.com/jeiang/erdtree",
    content:
      "My maintained fork of the multi-threaded filesystem and disk-usage utility; fixes bugs and adds features requested in upstream issues.",
  },
  {
    name: "dotfiles",
    link: "https://github.com/jeiang/.dotfiles",
    content: "My NixOS configuration for my personal computer and the server.",
  },
  {
    name: "wallpaper-finder",
    link: "https://github.com/jeiang/wallpaper-finder",
    content:
      "A tool for finding wallpapers of a given aspect ratio (can search 300+ GB of photos in a few seconds).",
  },
  {
    name: "6502-emulator",
    link: "https://github.com/jeiang/6502-emulator",
    content: "A very incomplete 6502 emulator.",
  },
  {
    name: "This website",
    link: "https://github.com/jeiang/website",
    content: "The site you're looking at, built with Astro and Tailwind.",
  },
];
---

<Layout title="Home" description={SITE_NAME}>
  <CustomSection title="whoami">
    <p>
      My name is Aidan Pinard. I am currently working as a DevOps Engineer for
      CIBC Caribbean. I'm interested in programming, *nix stuff, and F1. Check
      out <InlineLink href="/about">/about</InlineLink> to know more.
    </p>
  </CustomSection>
  <CustomSection title="ls ~/tech">
    <p class="text-muted dark:text-muted-dark">
      {interests.map((item) => `[${slug(item)}]`).join(" ")}
    </p>
  </CustomSection>
  <CustomSection title="ls ~/projects">
    <ul>
      {stuffIWorkedOn.map((item, i) => (
        <li
          class:list={[
            "pb-3",
            i > 0 &&
              "pt-3 border-t border-dashed border-hairline dark:border-hairline-dark",
          ]}
        >
          <InlineLink
            href={item.link}
            classes="font-bold text-accent dark:text-accent-dark"
          >
            → {item.name}
          </InlineLink>
          <p class="text-sm text-muted dark:text-muted-dark">{item.content}</p>
        </li>
      ))}
    </ul>
    <p class="pt-4 text-muted dark:text-muted-dark">
      $ <span class="cursor" aria-hidden="true" />
    </p>
  </CustomSection>
</Layout>
