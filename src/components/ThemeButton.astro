---
import { Icon } from "astro-icon/components";
---

<theme-button>
  <button
    aria-label="Toggle color theme"
    class="py-2 h-full px-4 border-2 rounded-lg border-dark dark:border-light"
  >
    <span data-theme-icon="system">
      <Icon name="computer" size={24} />
    </span>
    <span data-theme-icon="light">
      <Icon name="sun" size={24} />
    </span>
    <span data-theme-icon="dark">
      <Icon name="moon" size={24} />
    </span>
  </button>
</theme-button>

<script>
  declare global {
    interface Window {
      __theme: { cycle(): void };
    }
  }

  class ThemeButton extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector("button");
      if (!button || button.dataset.bound) return;
      button.dataset.bound = "true";
      button.addEventListener("click", () => window.__theme.cycle());
    }
  }

  if (!customElements.get("theme-button"))
    customElements.define("theme-button", ThemeButton);
</script>
