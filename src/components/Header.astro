---
import InlineLink from "./InlineLink.astro";
import ThemeButton from "./ThemeButton.astro";
import { SITE_NAME } from "../consts";

const user = SITE_NAME.split(" ")[0].toLowerCase();
const host = "pinard";
---

<header
  class="page-chrome sticky top-0 z-50 px-6 py-3 border-b border-dashed border-hairline dark:border-hairline-dark flex items-baseline gap-4 flex-wrap"
  transition:persist
>
  <h1 class="text-lg font-mono font-bold text-accent dark:text-accent-dark">
    {user}@{host}:~$
  </h1>
  <nav class="flex flex-grow flex-row gap-3 justify-end font-mono text-sm">
    <InlineLink href="/">[home]</InlineLink>
    <InlineLink href="/about">[about]</InlineLink>
    <InlineLink href="/contact">[contact]</InlineLink>
  </nav>
  <ThemeButton />
</header>
