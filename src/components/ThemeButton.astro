---
import { Icon } from "astro-icon/components";
---

<theme-button>
  <button
    aria-label="Toggle color theme"
    class="py-2 h-full px-4 border-2 rounded-lg border-dark dark:border-light"
  >
    <span data-theme-icon="system">
      <Icon name="computer" size={24} />
    </span>
    <span data-theme-icon="light" class="hidden">
      <Icon name="sun" size={24} />
    </span>
    <span data-theme-icon="dark" class="hidden">
      <Icon name="moon" size={24} />
    </span>
  </button>
</theme-button>

<script>
  declare global {
    interface Window {
      __theme: {
        mode(): "system" | "light" | "dark";
        apply(): void;
        cycle(): void;
      };
    }
  }

  class ThemeButton extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector("button");
      if (!button || button.dataset.bound) return;
      button.dataset.bound = "true";

      const syncIcon = () => {
        for (const icon of this.querySelectorAll<HTMLElement>(
          "[data-theme-icon]",
        ))
          icon.classList.toggle(
            "hidden",
            icon.dataset.themeIcon !== window.__theme.mode(),
          );
      };
      button.addEventListener("click", () => {
        window.__theme.cycle();
        window.__theme.apply();
        syncIcon();
      });
      syncIcon();
    }
  }

  if (!customElements.get("theme-button"))
    customElements.define("theme-button", ThemeButton);
</script>
