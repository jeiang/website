---
import InlineLink from "./InlineLink.astro";
import ThemeButton from "./ThemeButton.astro";
import { SITE_NAME } from "../consts";
---

<header
  class="page-chrome sticky top-0 z-50 border-b-2 border-dark dark:border-light px-6 py-4"
  transition:persist
>
  <h1 class="text-4xl pb-3 font-header font-bold">{SITE_NAME}</h1>
  <div class="flex flex-row">
    <nav class="flex flex-grow flex-row space-x-3">
      <InlineLink button href="/">
        Home
      </InlineLink>
      <InlineLink button href="/about">
        About
      </InlineLink>
      <InlineLink button href="/contact">
        Contact
      </InlineLink>
    </nav>
    <ThemeButton />
  </div>
</header>
