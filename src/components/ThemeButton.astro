---

<theme-button>
  <button
    aria-label="Toggle color theme"
    class="font-mono text-sm hover:text-accent dark:hover:text-accent-dark"
  >
    <span data-theme-icon="system">[~]</span>
    <span data-theme-icon="light">[+]</span>
    <span data-theme-icon="dark">[-]</span>
  </button>
</theme-button>

<script>
  declare global {
    interface Window {
      __theme: { cycle(): void };
    }
  }

  class ThemeButton extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector("button");
      if (!button || button.dataset.bound) return;
      button.dataset.bound = "true";
      button.addEventListener("click", () => window.__theme.cycle());
    }
  }

  if (!customElements.get("theme-button"))
    customElements.define("theme-button", ThemeButton);
</script>
